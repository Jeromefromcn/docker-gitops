# vps_oracle/compose/elasticsearch — secrets
# Copy to .env (chmod 600) and fill in real values. .env is gitignored.

# Built-in `elastic` superuser. Ops-only, never handed to apps.
# Only applied on first start with an empty data dir.
ELASTIC_PASSWORD=CHANGE_ME_elastic_superuser

# --- per-app users ---
# Written by scripts/es-provision-app.sh (generated if missing, never rotated
# on re-run). Naming: APP_<APP>_PASSWORD / APP_<APP>_DEV_PASSWORD (app names are
# alphanumeric only, see README).
# APP_RAG_PASSWORD=...
# APP_RAG_DEV_PASSWORD=...
