# vps_oracle/compose/redis — secrets
# Copy to .env and fill in real values. .env is gitignored (see repo root .gitignore).
# After editing, run:  ./scripts/gen-users-acl.sh  then  docker compose up -d

# Bootstrap superuser password (redis --requirepass). Ops-only, never used by apps.
REDIS_PASSWORD=CHANGE_ME_redis_superuser

# RedisInsight admin UI password (fronted by NPM Basic Auth self-only-and-auth).
REDISINSIGHT_PASSWORD=CHANGE_ME_redisinsight

# --- per-app ACL users ---
# Each app gets its own ACL user + key-prefix namespace, declared here.
# To add a new app: add a block and regenerate users.acl (see README).
# Naming convention: APP_<APPNAME>_PASSWORD + APP_<APPNAME>_KEY_PREFIX
APP_NOTES_PASSWORD=CHANGE_ME_app_notes
APP_NOTES_KEY_PREFIX=notes

APP_TODO_PASSWORD=CHANGE_ME_app_todo
APP_TODO_KEY_PREFIX=todo
