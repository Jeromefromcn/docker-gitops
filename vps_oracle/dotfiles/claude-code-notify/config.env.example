# Template for claude-code-notify's directory -> Telegram chat/bot routing config.
# The real file is config.env (same directory, blocked from git by the
# repo's .gitignore *.env rule), symlinked in from
# ~/.claude/claude-code-notify/config.env.
#
# Copy this to config.env to get started; ROUTE_<n>_DIR uses longest-prefix
# match to decide which chat/bot a session's cwd should notify, falling back
# to the global defaults below when no route matches.

TELEGRAM_BOT_TOKEN=<global default bot token>
TELEGRAM_CHAT_ID=<global default chat id>
NOTIFY_RATELIMIT_SECONDS=120
NOTIFY_DEBUG=true
NOTIFY_USAGE_LIMIT=true

ROUTE_1_DIR=/home/ubuntu/jerome/notify-test
ROUTE_1_CHAT_ID=<chat id>
ROUTE_1_BOT_TOKEN=<bot token>

ROUTE_2_DIR=/home/ubuntu/bridget
ROUTE_2_CHAT_ID=<chat id>
ROUTE_2_BOT_TOKEN=<bot token>

ROUTE_3_DIR=/home/ubuntu/bridget/love-bird-boss
ROUTE_3_CHAT_ID=<chat id>
