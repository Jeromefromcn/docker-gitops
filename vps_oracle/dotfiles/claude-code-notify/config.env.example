# claude-code-notify 的目录 -> Telegram chat/bot 路由配置模板。
# 真身是 config.env（同目录，被仓库 .gitignore 的 *.env 规则挡住，不进 git），
# 由 ~/.claude/claude-code-notify/config.env 软链过来。
#
# 复制这份改成 config.env 即可开始用；ROUTE_<n>_DIR 用最长前缀匹配决定
# 一个 session 的 cwd 该通知到哪个 chat/bot，未命中的目录退回下面的全局默认值。

TELEGRAM_BOT_TOKEN=<全局默认 bot token>
TELEGRAM_CHAT_ID=<全局默认 chat id>
NOTIFY_RATELIMIT_SECONDS=120
NOTIFY_DEBUG=true
NOTIFY_USAGE_LIMIT=true

ROUTE_1_DIR=/home/ubuntu/jerome/notify-test
ROUTE_1_CHAT_ID=<chat id>
ROUTE_1_BOT_TOKEN=<bot token>

ROUTE_2_DIR=/home/ubuntu/bridget
ROUTE_2_CHAT_ID=<chat id>
ROUTE_2_BOT_TOKEN=<bot token>

ROUTE_3_DIR=/home/ubuntu/bridget/love-bird-boss
ROUTE_3_CHAT_ID=<chat id>
