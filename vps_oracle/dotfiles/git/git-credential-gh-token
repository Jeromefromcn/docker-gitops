#!/usr/bin/env bash
# git credential helper: 从 ~/.gh-token-<account> 动态读 token, 拼出 git 需要的凭据。
#
# 用法 (在 .gitconfig-<account> 里配置, account + github 用户名都作为参数传入):
#   [credential "https://github.com"]
#       helper = !/home/ubuntu/jerome/docker-gitops/vps_oracle/dotfiles/git/git-credential-gh-token <account> <github-username>
#
# git 调用 credential helper 时, 自定义参数在前, 动作(get/store/erase)由 git 追加在最后:
#   $1=<account>  $2=<github-username>  $3=<action>
#
# token 唯一来源是 ~/.gh-token-<account> (裸 token), 本脚本在 git 认证时实时读取,
# 不需要 .git-credentials-* 文件。换 token 只改 ~/.gh-token-<account> 一处。

account="$1"
username="$2"
action="$3"

if [ "$action" = "get" ]; then
  host="$(awk -F= '$1=="host" {print $2; exit}' </dev/stdin 2>/dev/null || true)"
  if [ "$host" = "github.com" ]; then
    printf 'username=%s\npassword=%s\n' "$username" "$(cat "$HOME/.gh-token-$account")"
  fi
fi
# store/erase 和其他动作: 静默退出, token 一直在 ~/.gh-token-<account> 里, 无需持久化
exit 0
