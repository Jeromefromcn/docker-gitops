#!/usr/bin/env bash
# git credential helper: dynamically reads the token from
# ~/.gh-token-<account> and assembles the credentials git needs.
#
# Usage (configured in .gitconfig-<account>; both account and the GitHub
# username are passed in as arguments):
#   [credential "https://github.com"]
#       helper = !/home/ubuntu/jerome/docker-gitops/vps_oracle/dotfiles/git/git-credential-gh-token <account> <github-username>
#
# When git invokes a credential helper, custom arguments come first and the
# action (get/store/erase) is appended by git at the end:
#   $1=<account>  $2=<github-username>  $3=<action>
#
# The token's sole source is ~/.gh-token-<account> (bare token); this script
# reads it live at git-auth time, so no .git-credentials-* file is needed.
# Rotating a token only requires changing ~/.gh-token-<account> in one place.

account="$1"
username="$2"
action="$3"

if [ "$action" = "get" ]; then
  host="$(awk -F= '$1=="host" {print $2; exit}' </dev/stdin 2>/dev/null || true)"
  if [ "$host" = "github.com" ]; then
    printf 'username=%s\npassword=%s\n' "$username" "$(cat "$HOME/.gh-token-$account")"
  fi
fi
# store/erase and other actions: exit silently — the token always lives in
# ~/.gh-token-<account>, so there's nothing to persist.
exit 0
