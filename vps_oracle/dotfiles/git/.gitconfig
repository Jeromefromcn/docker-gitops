# The global .gitconfig deliberately sets no user / credential:
# only the three account directories ~/jerome/, ~/bridget/, ~/evidence/ can
# commit (each gets its identity from its own includeIf).
# Committing outside an account directory fails with "fatal: no user.name" —
# this is an intentional safety constraint; add another includeIf rule when needed.

[includeIf "gitdir:~/jerome/"]
    path = ~/.gitconfig-jerome

[includeIf "gitdir:~/bridget/"]
    path = ~/.gitconfig-bridget

[includeIf "gitdir:~/evidence/"]
    path = ~/.gitconfig-evidence
