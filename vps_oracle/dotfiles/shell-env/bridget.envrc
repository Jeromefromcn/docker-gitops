# bridget account 的 direnv 環境
# 這份是無密鑰模板: provider/account 環境檔名、GH token 檔名都是帳戶名, 不含密鑰本身
# 真憑證活在: ~/.claude-provider/bridget.env, ~/.claude-account/bridget.env, ~/.gh-token-bridget

# claude 環境: provider 優先, account 備援
source_env_if_exists /home/ubuntu/.claude-provider/bridget.env
source_env_if_exists /home/ubuntu/.claude-account/bridget.env

# bridget 帳號的 GitHub token (執行時 cat, 不存字面值)
export GH_TOKEN="$(cat /home/ubuntu/.gh-token-bridget)"

# go 工具鏈 (go/go/bin 放 go 自身, go/bin 放 go install 產物)
# 放這裡而不是 .bashrc: cc session 是非交互 shell 不讀 .bashrc, 靠 direnv 拿環境
PATH_add /home/ubuntu/go/go/bin
PATH_add /home/ubuntu/go/bin
