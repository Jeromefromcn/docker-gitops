# direnv environment for the bridget account
# This is a key-free template: the provider/account env file names and the
# GH token file name are just the account name, they hold no key material.
# The real credentials live at: ~/.claude-provider/bridget.env,
# ~/.claude-account/bridget.env, ~/.gh-token-bridget

# claude environment: provider first, account as fallback
source_env_if_exists /home/ubuntu/.claude-provider/bridget.env
source_env_if_exists /home/ubuntu/.claude-account/bridget.env

# GitHub token for the bridget account (cat'd at run time, never stored literally)
export GH_TOKEN="$(cat /home/ubuntu/.gh-token-bridget)"

# go toolchain (go/go/bin holds go itself, go/bin holds go install artifacts)
# Set here rather than in .bashrc: a cc session is a non-interactive shell
# that doesn't read .bashrc, so it relies on direnv for its environment
PATH_add /home/ubuntu/go/go/bin
PATH_add /home/ubuntu/go/bin
