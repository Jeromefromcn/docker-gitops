# evidence account 的 direnv 環境
# 無密鑰模板, 憑證活在系統: ~/.claude-provider/evidence.env, ~/.claude-account/evidence.env, ~/.gh-token-evidence

# claude 環境: provider 優先, account 備援
source_env_if_exists /home/ubuntu/.claude-provider/evidence.env
source_env_if_exists /home/ubuntu/.claude-account/evidence.env

# evidence 帳號的 GitHub token (執行時 cat, 不存字面值)
export GH_TOKEN="$(cat /home/ubuntu/.gh-token-evidence)"
