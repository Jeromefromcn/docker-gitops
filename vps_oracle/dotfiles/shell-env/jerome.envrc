# direnv environment for the jerome account
# Key-free template; the real credentials live on the system:
# ~/.claude-provider/jerome.env, ~/.claude-account/jerome.env, ~/.gh-token-jerome

# claude environment: provider first, account as fallback
source_env_if_exists /home/ubuntu/.claude-provider/jerome.env
source_env_if_exists /home/ubuntu/.claude-account/jerome.env

# GitHub token for the jerome account (cat'd at run time, never stored literally)
export GH_TOKEN="$(cat /home/ubuntu/.gh-token-jerome)"

# go toolchain (go/go/bin holds go itself, go/bin holds go install artifacts)
# Set here rather than in .bashrc: a cc session is a non-interactive shell
# that doesn't read .bashrc, so it relies on direnv for its environment
PATH_add /home/ubuntu/go/go/bin
PATH_add /home/ubuntu/go/bin
