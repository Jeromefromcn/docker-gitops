# jerome account 的 direnv 環境
# 無密鑰模板, 憑證活在系統: ~/.claude-provider/jerome.env, ~/.claude-account/jerome.env, ~/.gh-token-jerome

# claude 環境: provider 優先, account 備援
source_env_if_exists /home/ubuntu/.claude-provider/jerome.env
source_env_if_exists /home/ubuntu/.claude-account/jerome.env

# jerome 帳號的 GitHub token (執行時 cat, 不存字面值)
export GH_TOKEN="$(cat /home/ubuntu/.gh-token-jerome)"
