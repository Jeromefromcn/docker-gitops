# Copy to .env and fill in (the real .env is gitignored).
#
# SillyTavern's own HTTP basic-auth credential, injected via
# SILLYTAVERN_BASICAUTHUSER_* in docker-compose.yml. NPM adds a second layer
# on top of it (access list `self-only-and-auth`), so the browser prompts twice.
#
# User accounts are off (`enableUserAccounts: false`, ST's default), so this is
# the single shared credential — the username is arbitrary and does not map to
# an ST user handle.
SILLYTAVERN_USERNAME=
SILLYTAVERN_PASSWORD=
