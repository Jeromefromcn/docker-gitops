{
	// Define the tags which can be applied to devices and by which users.
	"tagOwners": {
		"tag:oracle-hub": ["autogroup:admin"],
		"tag:gcp-lab":    ["autogroup:admin"],
		"tag:oracle2":    ["autogroup:admin"],
	},

	// Define grants that govern access for users, groups, autogroups, tags,
	// Tailscale IP addresses, and subnet ranges.
	"grants": [
		// Only oracle-hub can reach gcp-lab, on any port/protocol — oracle already has
		// full SSH (public IP, non-tailscale) access to gcp, so this grants no new
		// capability beyond what SSH already allows; it just lets services on oracle
		// (e.g. prometheus scraping node-exporter) reach gcp directly over the mesh
		// instead of needing a per-port grant added every time. One-directional:
		// gcp-lab cannot initiate anything back to oracle-hub, and nothing else in
		// this tailnet can reach tag:gcp-lab at all.
		{"src": ["tag:oracle-hub"], "dst": ["tag:gcp-lab"], "ip": ["*"]},

		// Same pattern for oracle2 (separate OCI tenancy): oracle-hub -> oracle2 only,
		// one-directional, nothing else can reach tag:oracle2.
		{"src": ["tag:oracle-hub"], "dst": ["tag:oracle2"], "ip": ["*"]},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
