#!/bin/bash
# demo-window start|stop <scenario> — records the scenario's UTC window.
. "$(dirname "$(readlink -f "$0")")/lib.sh"
[ $# -eq 2 ] || die "usage: demo-window start|stop <scenario>"
action=$1 s=$2
f=$(scenario_file "$s")
WINDOW_FILE=$(window_file "$s")
case $action in
  start)
    # shellcheck disable=SC1090
    . "$f"
    # prepare_<name> runs BEFORE the window opens, so what it changes (e.g. pausing the
    # background traffic) is already in effect for every second of the window.
    prep="prepare_$(fn_name "$s")"
    if declare -F "$prep" >/dev/null; then "$prep"; fi
    t=$(now)
    echo "WINDOW_START=$t" > "$WINDOW_FILE"
    fn="start_$(fn_name "$s")"
    if declare -F "$fn" >/dev/null; then "$fn"; fi
    echo "window $s started $(iso "$t")" ;;
  stop)
    [ -f "$WINDOW_FILE" ] || die "no window started for '$s'"
    # A second stop would silently stretch the window past the scenario.
    if e=$(grep -oP '^WINDOW_END=\K.*' "$WINDOW_FILE"); then
      echo "demo: window $s already stopped $(iso "$e") — kept; run 'demo-window start $s' to redo it" >&2
      exit 0
    fi
    t=$(now)
    echo "WINDOW_END=$t" >> "$WINDOW_FILE"
    echo "window $s stopped $(iso "$t")" ;;
  *) die "usage: demo-window start|stop <scenario>" ;;
esac
