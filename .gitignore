# secrets / env
.env
.env.*
*.env
!.env.example

# generated per-app redis ACL (contains real passwords; regenerated by
# vps_oracle/compose/redis/scripts/gen-users-acl.sh from .env)
vps_oracle/compose/redis/redis/users.acl
.bash_secrets
!.bash_secrets.example
secrets/
# SealedSecret manifests are encrypted at rest and safe to commit — exempt
# this path from the blanket "secrets/" rule above.
!k3s/sealed-secrets/secrets/
!k3s/sealed-secrets/secrets/**
*.pem
*.key
*credentials*.json

# dotfiles: only the example (without the real OAuth token) goes into git
vps_oracle/dotfiles/config/rclone.conf
vps_oracle/dotfiles/config/gh-hosts.yml
# claude/jerome's permission settings are managed as the real thing, excepted from the global settings.local.json rule
!vps_oracle/dotfiles/claude-jerome/.claude/settings.local.json

# local overrides (host-specific, not shared)
docker-compose.override.yml
docker-compose.*.local.yml
CLAUDE.local.md

# backups / temp
*.bak
*.tmp
*~
.DS_Store

# editor
.vscode/
.idea/

# python
__pycache__/

# runtime logs written by containers into mounted config dirs
vps_oracle/compose/homepage/config/logs/

# runtime dedup/comparison state written by the host inspector
vps_oracle/host-native/inspector/state/

# superpowers subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/sdd/
.worktrees/

# OpenTofu (vps_oracle/tofu, vps_gcp/tofu)
*.tfstate
*.tfstate.*
.terraform/
*.auto.tfvars
